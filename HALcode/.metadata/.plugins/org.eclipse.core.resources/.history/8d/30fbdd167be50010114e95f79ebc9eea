/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_ADC1_Init();

  /* USER CODE BEGIN 2 */
  char lcd_buf[16];
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* Read ADC value */
    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY);
    adc_value = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);

    /* LCD Line 1 */
    lcd_put_cur(0, 0);
    lcd_send_string("GAS ADC:     ");
    lcd_put_cur(0, 9);
    sprintf(lcd_buf, "%lu", adc_value);
    lcd_send_string(lcd_buf);

    /* LCD Line 2 */
    lcd_put_cur(1, 0);
    if (adc_value < 1200)
      lcd_send_string("AIR: GOOD     ");
    else if (adc_value < 2500)
      lcd_send_string("AIR: MODERATE ");
    else
      lcd_send_string("AIR: BAD !!!  ");

    HAL_Delay(1000);
  }
  /* USER CODE END WHILE */
}

